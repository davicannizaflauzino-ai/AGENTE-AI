{
  "tools": [
    {
      "name": "ping",
      "description": "Pinga um endereço",
      "command": "ping -n 3 {endereco}",
      "params": [
        {
          "name": "endereco",
          "type": "string",
          "description": "IP ou hostname"
        }
      ]
    },
    {
      "name": "ip_config",
      "description": "Mostra configuração de rede",
      "command": "ipconfig"
    }
  ]
}